[Unit]
Description=RudraX WebUI - AI Autonomous Stack Interface
Documentation=https://github.com/iamlalitpandit/RudraX
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/RudraX
ExecStart=%h/.nvm/versions/node/v22.0.0/bin/node %h/RudraX/webui/server.js 5555
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Environment
Environment=NODE_ENV=production
Environment=RUDRAX_WEBUI_PORT=5555
Environment=RUDRAX_WEBUI_CHILD=1

# Logging
StandardOutput=append:%h/.rudrax/logs/webui-out.log
StandardError=append:%h/.rudrax/logs/webui-error.log

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/.rudrax %h/RudraX

[Install]
WantedBy=default.target