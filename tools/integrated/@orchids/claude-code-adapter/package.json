{
  "name": "@orchids/claude-code-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code JSON-mode process adapter for Orchids",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tool-result": {
      "types": "./dist/tool-result.d.ts",
      "import": "./dist/tool-result.js",
      "default": "./dist/tool-result.js"
    },
    "./turn-utils": {
      "types": "./dist/turn-utils.d.ts",
      "import": "./dist/turn-utils.js",
      "default": "./dist/turn-utils.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/parser.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "ms": "^2.1.3",
    "neverthrow": "^8.2.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/ms": "^2.1.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}