{
  "name": "rudrax-integrated-tools",
  "version": "2.0.0",
  "description": "RudraX Tools - Systematically organized tools, agents, and capabilities",
  "categories": {
    "ai-assistants": {
      "label": "🤖 AI Assistants",
      "description": "AI-powered coding and reasoning assistants",
      "tools": ["codex", "claude", "ollama"]
    },
    "ide": {
      "label": "💻 IDE & Server",
      "description": "Development environments and web servers",
      "tools": ["code-server"]
    },
    "search": {
      "label": "🔍 Search & Utility",
      "description": "Code search, analysis, and utility tools",
      "tools": ["ripgrep"]
    },
    "adapters": {
      "label": "🔌 Adapters & Integration",
      "description": "Integration bridges between AI assistants and RudraX",
      "tools": ["codex-adapter", "claude-adapter"]
    }
  },
  "tools": {
    "codex": {
      "name": "OpenAI Codex CLI",
      "description": "AI-powered coding assistant from OpenAI",
      "type": "cli",
      "path": "./integrated/codex/linux-x64/bin/codex",
      "launcher": "./launchers/codex-launcher.sh",
      "available": true,
      "category": "ai-assistants",
      "tags": ["ai", "coding", "openai"],
      "commands": {
        "launch": "rudrax tools codex [args...]",
        "help": "rudrax tools codex --help"
      }
    },
    "claude": {
      "name": "Claude Code CLI",
      "description": "Anthropic's Claude code assistant for AI-powered development",
      "type": "cli",
      "path": "./integrated/claude-code/linux-x64/bin/claude",
      "launcher": "./launchers/claude-launcher.sh",
      "available": true,
      "category": "ai-assistants",
      "tags": ["ai", "coding", "anthropic"],
      "commands": {
        "launch": "rudrax tools claude [args...]",
        "help": "rudrax tools claude --help"
      }
    },
    "ollama": {
      "name": "Ollama Bridge",
      "description": "Direct Ollama API integration for local LLM access",
      "type": "api",
      "endpoint": "http://172.31.32.172:11434",
      "models": ["minimax-m2.7:cloud", "kimi-k2.6:cloud"],
      "defaultModel": "kimi-k2.6:cloud",
      "available": true,
      "category": "ai-assistants",
      "tags": ["ai", "ollama", "local-llm"],
      "commands": {
        "prompt": "rudrax tools ollama <prompt>",
        "models": "rudrax tools models"
      }
    },
    "code-server": {
      "name": "VS Code Server",
      "description": "VS Code in browser - full IDE accessible via web",
      "type": "web-ide",
      "path": "./integrated/code-server/linux-x64/bin/code-server",
      "launcher": "./launchers/code-server-launcher.sh",
      "available": true,
      "category": "ide",
      "tags": ["ide", "vscode", "web"],
      "config": {
        "defaultPort": 8080,
        "bindAddress": "0.0.0.0",
        "auth": "none"
      },
      "commands": {
        "launch": "rudrax tools server [port]",
        "status": "curl -s http://127.0.0.1:8080"
      }
    },
    "ripgrep": {
      "name": "Ripgrep",
      "description": "Ultra-fast text search tool that respects .gitignore",
      "type": "utility",
      "path": "./integrated/codex/linux-x64/bin/rg",
      "available": true,
      "category": "search",
      "tags": ["search", "grep", "utility"],
      "commands": {
        "search": "rudrax tools rg <pattern> [path]",
        "files": "rudrax tools rg <pattern> --files-with-matches"
      }
    },
    "codex-adapter": {
      "name": "Codex Integration Adapter",
      "description": "Adapter bridging Codex with RudraX internals",
      "type": "adapter",
      "path": "./integrated/@orchids/codex-adapter",
      "entry": "./integrated/@orchids/codex-adapter/dist/index.js",
      "available": true,
      "category": "adapters",
      "tags": ["adapter", "codex", "integration"],
      "commands": {
        "import": "import { rudraxTools } from './tools/lib/rudrax-tools.js'; const a = await rudraxTools.loadCodexAdapter();"
      }
    },
    "claude-adapter": {
      "name": "Claude Code Adapter",
      "description": "Adapter bridging Claude Code with RudraX internals",
      "type": "adapter",
      "path": "./integrated/@orchids/claude-code-adapter",
      "entry": "./integrated/@orchids/claude-code-adapter/dist/index.js",
      "available": true,
      "category": "adapters",
      "tags": ["adapter", "claude", "integration"],
      "commands": {
        "import": "import { rudraxTools } from './tools/lib/rudrax-tools.js'; const a = await rudraxTools.loadClaudeAdapter();"
      }
    }
  },
