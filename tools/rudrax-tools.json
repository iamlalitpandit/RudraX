  "config": {
    "ollama": {
      "enabled": true,
      "endpoint": "http://172.31.32.172:11434",
      "models": [
        "minimax-m2.7:cloud",
        "kimi-k2.6:cloud"
      ],
      "defaultModel": "kimi-k2.6:cloud"
    },
    "code-server": {
      "auth": "none",
      "defaultPort": 8080,
      "bindAddress": "127.0.0.1"
    },
    "integration": {
      "mode": "standalone",
      "priority": "ollama-custom"
    }
  }
