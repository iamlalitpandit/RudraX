{
  "name": "rudrax",
  "version": "4.5.0",
  "description": "RudraX Army v4.5.0 — Build · Break · Deploy · Orchestrate: Hierarchical Multi-Agent Command System with 192 AI Specialists & 15 Advanced Agentic Capabilities by Lalit Pandit",
  "type": "module",
  "main": "lib/main.js",
  "piConfig": {
    "name": "rudrax",
    "configDir": ".rudrax"
  },
  "bin": {
    "rudrax": "bin/rudrax",
    "rx": "bin/rudrax",
    "rudrax-tools": "tools/bin/rudrax-tools",
    "rudrax-web": "webui/server.js"
  },
  "scripts": {
    "start": "node bin/rudrax",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run tests/smoke.test.js",
    "test:unit": "vitest run tests/unit",
    "lint": "node --check lib/core/provider-catalog.js && node --check lib/core/model-registry.js && node --check lib/core/auth-storage.js && node --check lib/core/model-resolver.js && node --check webui/provider-api.js && node --check webui/server.js && node --check webui/js/app.js",
    "pretest": "echo '🧪 RudraX Tests — Running vitest...'",
    "install-global": "npm install -g .",
    "tools": "node tools/bin/rudrax-tools",
    "tools:status": "node tools/bin/rudrax-tools status",
    "tools:server": "node tools/bin/rudrax-tools server 8080",
    "webui": "node webui/server.js",
    "webui:dev": "RUDRAX_WEBUI_PORT=5555 node webui/server.js",
    "webui:bg": "node lib/core/webui-manager.js",
    "webui:install-service": "bash deploy/install-webui-service.sh"
  },
  "keywords": [
    "rudrax",
    "rudrax-army",
    "ai-agent",
    "multi-agent",
    "command-hierarchy",
    "agent-orchestration",
    "tui",
    "cli",
    "coding-agent",
    "build-break-deploy",
    "agent-swarm",
    "autonomous-ai"
  ],
  "author": {
    "name": "Lalit Pandit",
    "email": "admin@rudrax.cloud",
    "url": "https://www.lalitpandit.in"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@azure/identity": "^4.13.1",
    "@google/genai": "^2.6.0",
    "@google/generative-ai": "^0.24.1",
    "@imlalitpandit/jiti": "^1.0.2",
    "@imlalitpandit/pi-agent-core": "^1.0.1",
    "@imlalitpandit/pi-ai": "^1.0.1",
    "@imlalitpandit/pi-tui": "^1.0.1",
    "@sinclair/typebox": "^0.34.49",
    "@types/mime-types": "^3.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.4.0",
    "cli-highlight": "^2.1.11",
    "diff": "^8.0.4",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "file-type": "^22.0.0",
    "get-east-asian-width": "^1.5.0",
    "glob": "^13.0.6",
    "hosted-git-info": "^9.0.2",
    "ignore": "^7.0.5",
    "koffi": "^2.16.1",
    "marked": "^18.0.2",
    "mime-types": "^3.0.2",
    "minimatch": "^10.2.5",
    "nodemailer": "^8.0.8",
    "openai": "^6.35.0",
    "partial-json": "^0.1.7",
    "proper-lockfile": "^4.1.2",
    "proxy-agent": "^8.0.1",
    "socket.io": "^4.8.3",
    "undici": "^8.1.0",
    "yaml": "^2.8.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/iamlalitpandit/RudraX"
  },
  "homepage": "https://github.com/iamlalitpandit/RudraX",
  "bugs": {
    "url": "https://github.com/iamlalitpandit/RudraX/issues",
    "email": "admin@rudrax.cloud"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.7",
    "vitest": "^4.1.7"
  }
}
