{
  "name": "rudrax",
  "version": "1.0.0",
  "description": "RudraX - Build Break Deploy: Interactive AI TUI for development workflows",
  "type": "module",
  "main": "lib/main.js",
  "piConfig": {
    "name": "rudrax",
    "configDir": ".rudrax"
  },
  "bin": {
    "rudrax": "bin/rudrax",
    "rx": "bin/rudrax",
    "rudrax-tools": "tools/bin/rudrax-tools",
    "rudrax-web": "webui/server.js"
  },
  "scripts": {
    "start": "node bin/rudrax",
    "test": "echo 'RudraX TUI tests not included'",
    "install-global": "npm install -g .",
    "tools": "node tools/bin/rudrax-tools",
    "tools:status": "node tools/bin/rudrax-tools status",
    "tools:server": "node tools/bin/rudrax-tools server 8080",
    "webui": "node webui/server.js",
    "webui:dev": "RUDRAX_WEBUI_PORT=5555 node webui/server.js",
    "webui:bg": "node lib/core/webui-manager.js",
    "webui:install-service": "bash deploy/install-webui-service.sh"
  },
  "keywords": [
    "rudrax",
    "tui",
    "cli",
    "ai",
    "coding-agent",
    "interactive",
    "build-break-deploy"
  ],
  "author": "Lalit Pandit",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google/generative-ai": "^0.24.1",
    "@imlalitpandit/jiti": "^1.0.2",
    "@imlalitpandit/pi-agent-core": "^1.0.1",
    "@imlalitpandit/pi-ai": "^1.0.1",
    "@imlalitpandit/pi-tui": "^1.0.1",
    "@sinclair/typebox": "^0.34.49",
    "@types/mime-types": "^3.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.x",
    "cli-highlight": "^2.1.11",
    "diff": "^8.0.4",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "file-type": "^22.0.0",
    "get-east-asian-width": "^1.5.0",
    "glob": "^13.0.6",
    "hosted-git-info": "^9.0.2",
    "ignore": "^7.0.5",
    "koffi": "^2.16.1",
    "marked": "^18.0.2",
    "mime-types": "^3.0.2",
    "minimatch": "^10.2.5",
    "openai": "^6.35.0",
    "partial-json": "^0.1.7",
    "proper-lockfile": "^4.1.2",
    "proxy-agent": "^8.0.1",
    "socket.io": "^4.8.3",
    "undici": "^8.1.0",
    "yaml": "^2.8.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/iamlalitpandit/RudraX"
  },
  "homepage": "https://github.com/iamlalitpandit/RudraX"
}
